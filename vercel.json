{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "https://johar-xdgx.onrender.com/uploads/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://johar-xdgx.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
