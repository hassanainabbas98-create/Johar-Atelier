# ==============================================================================
# L'Archive Vivante - Client Environment Configuration Example
# ==============================================================================
#
# Option A (Recommended - Unified Reverse Proxy or Single Origin):
# Leave VITE_API_BASE_URL blank or omitted.
# The React SPA will send all API requests to the relative '/api' endpoint,
# which avoids cross-origin CORS hurdles and allows HttpOnly session cookies
# to operate seamlessly without third-party cookie restrictions.
#
# Option B (Split Origin - e.g. React SPA on Vercel/Netlify, API on Azure/VPS):
# Set VITE_API_BASE_URL to the absolute HTTPS URL of your deployed ASP.NET Core API.
# Example:
# VITE_API_BASE_URL=https://api.atelier-gallery.com/api
#
# Note: In Option B, ensure the backend's Cors:AllowedOrigins configuration
# explicitly includes your frontend's production origin (e.g., https://atelier-gallery.com).
# ==============================================================================

VITE_API_BASE_URL=
